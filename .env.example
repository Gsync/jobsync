# Note: Copy these variables in your .env file

# DATABASE_URL=file:./dev.db

# If you are running it on a remote server/homelab, you must update timezone otherwise activities times may shift
TZ=America/Edmonton

# For homelab server, change the following to your server ip ex: http://192.168.x.x:3737
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (homelab ip, reverse proxy)
AUTH_TRUST_HOST=true

# AUTH_SECRET is auto-generated by deploy.sh and docker-entrypoint.sh
# To set manually, uncomment and provide your own value:
# AUTH_SECRET=

# ENCRYPTION_KEY is used to encrypt stored API keys (OpenAI, DeepSeek, etc.)
# Must be stable across restarts — changing it will make all stored API keys unrecoverable
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek API Key - get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Gemini API Key - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key - get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# For homelab server, if you ollama is running on server, change the following to your ollamma ip ex: http://192.168.x.x:12345
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI Configuration
# The system uses LLM-based semantic extraction for intelligent, context-aware skill matching
# No configuration needed - semantic extraction is the default

# Enables the MCP server in production (default: on in dev, off in prod)
MCP_ENABLED=true

# Observability (OTel traces + logs to a self-hosted OpenObserve instance)
# Off by default — leave all four commented out for no change in behaviour.
# Base URL only; the app appends /v1/traces and /v1/logs itself
# OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(email:token)
# OTEL_SERVICE_NAME=jobsync
# Also captures prompt/response content on LLM spans — has no effect unless OTEL_EXPORTER_OTLP_ENDPOINT above is also set
# OTEL_CAPTURE_CONTENT=false
