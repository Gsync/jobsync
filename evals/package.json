{
  "name": "jobsync-evals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "eval:resume-review": "tsx run-eval.ts resume-review/promptfooconfig.yaml",
    "eval:job-match": "tsx run-eval.ts job-match/promptfooconfig.yaml",
    "eval:automation-match": "tsx run-eval.ts job-match/automation.promptfooconfig.yaml",
    "eval:cover-letter": "tsx run-eval.ts cover-letter/promptfooconfig.yaml",
    "eval:resume-import": "tsx run-eval.ts resume-import/promptfooconfig.yaml",
    "eval:mcp-tools": "tsx mcp-tools/generate-tools.ts && tsx run-eval.ts mcp-tools/promptfooconfig.yaml",
    "eval:agent-chat": "tsx agent-chat/generate-tools.ts && tsx run-eval.ts agent-chat/promptfooconfig.yaml",
    "eval:agent-chat-latency": "tsx agent-chat/generate-tools.ts && tsx agent-chat/latency.ts",
    "eval:all": "tsx run-eval.ts promptfooconfig.yaml",
    "eval:view": "promptfoo view"
  },
  "devDependencies": {
    "promptfoo": "^0.125.0",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "@hono/node-server": ">=2.1.6 <3"
  }
}
