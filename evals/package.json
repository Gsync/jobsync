{
  "name": "jobsync-evals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "eval:resume-review": "promptfoo eval --no-cache --env-file ../.env --config resume-review/promptfooconfig.yaml",
    "eval:job-match": "promptfoo eval --no-cache --env-file ../.env --config job-match/promptfooconfig.yaml",
    "eval:automation-match": "promptfoo eval --no-cache --env-file ../.env --config job-match/automation.promptfooconfig.yaml",
    "eval:cover-letter": "promptfoo eval --no-cache --env-file ../.env --config cover-letter/promptfooconfig.yaml",
    "eval:multilingual": "promptfoo eval --no-cache --env-file ../.env --config multilingual/promptfooconfig.yaml",
    "eval:resume-import": "promptfoo eval --no-cache --env-file ../.env --config resume-import/promptfooconfig.yaml",
    "eval:mcp-tools": "tsx mcp-tools/generate-tools.ts && promptfoo eval --no-cache --env-file ../.env --config mcp-tools/promptfooconfig.yaml",
    "eval:agent-chat": "tsx agent-chat/generate-tools.ts && promptfoo eval --no-cache --env-file ../.env --config agent-chat/promptfooconfig.yaml",
    "eval:all": "promptfoo eval --no-cache --env-file ../.env --config promptfooconfig.yaml",
    "eval:view": "promptfoo view"
  },
  "devDependencies": {
    "promptfoo": "^0.125.0",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "picomatch@^2": "^2.3.2",
    "sharp": ">=0.35.5 <0.36",
    "axios": ">=1.20.0 <2",
    "fast-uri": ">=3.1.9 <4",
    "hono": ">=4.13.11 <5",
    "body-parser": ">=2.4.0 <3",
    "js-yaml@5": ">=5.4.1 <6",
    "fast-xml-parser": ">=5.10.1 <6",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "ip-address": ">=10.7.1 <11",
    "ws": ">=8.21.0 <9",
    "esbuild": ">=0.28.1 <0.29",
    "mongoose": ">=9.7.2 <10",
    "adm-zip": ">=0.6.1 <0.7"
  }
}
