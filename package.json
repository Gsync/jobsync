{
  "name": "jobsync",
  "version": "1.2.1",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev -p 3737",
    "dev:webpack": "next dev --webpack -p 3737",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "npx playwright test --project=chromium",
    "test:watch": "vitest --project unit --project component",
    "test:coverage": "vitest run --coverage --project unit --project component",
    "release:notes": "node scripts/release-notes.mjs",
    "eval:resume-review": "npm --prefix evals run eval:resume-review",
    "eval:job-match": "npm --prefix evals run eval:job-match",
    "eval:automation-match": "npm --prefix evals run eval:automation-match",
    "eval:resume-import": "npm --prefix evals run eval:resume-import",
